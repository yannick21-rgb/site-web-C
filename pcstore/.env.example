# ==============================
# PCStore — variables d'environnement
# ==============================

# DEV LOCAL (SQLite)
DATABASE_URL="file:./dev.db"

# PROD (Vercel + PostgreSQL) — utiliser l'URL fournie par Vercel Postgres / Neon :
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
#
# Le provider Prisma est détecté automatiquement d'après DATABASE_URL :
#   - "file:..."   → sqlite (dev)
#   - "postgres…"  → postgresql (prod)

# Auth admin — secret HMAC des sessions (OBLIGATOIRE, ≥ 32 caractères)
# Génère-en un avec : openssl rand -base64 32
# Sans cette variable, aucune session admin n'est valide (échec fermé).
AUTH_SECRET=""

# Création du compte admin (npm run admin:create) — à définir à l'exécution,
# jamais committé.
# ADMIN_CREATE_EMAIL="toi@exemple.com"
# ADMIN_CREATE_PASSWORD=""

# Mot de passe de l'admin créé par `npm run db:seed` (optionnel).
# Sans lui, le seed ne crée aucun compte admin.
# ADMIN_SEED_PASSWORD=""

# Notifications email admin (Resend)
ADMIN_NOTIF_EMAIL="admin@pcstore.bj"
EMAIL_FROM="PCStore <onboarding@resend.dev>"
# Clé API Resend — absente en dev : les notifications sont journalisées dans la console
# RESEND_API_KEY="re_xxxx"