{
  "name": "pcstore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "predev": "tsx scripts/prepare-prisma.ts",
    "prebuild": "tsx scripts/prepare-prisma.ts",
    "postinstall": "tsx scripts/prepare-prisma.ts && prisma generate",
    "db:push": "tsx scripts/prepare-prisma.ts && prisma db push",
    "db:seed": "tsx scripts/prepare-prisma.ts && prisma db seed",
    "admin:create": "npx tsx scripts/create-admin.ts",
    "db:deploy": "tsx scripts/prepare-prisma.ts && prisma db push && prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "next": "14.2.15",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}